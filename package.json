{
  "name": "english-academy-student-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/verify-preview-environment.mjs && node scripts/check-feature-map.mjs --verify",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=4",
    "test:component": "vitest run src/test-support/component-testing.smoke.test.tsx",
    "test:e2e": "node scripts/run-playwright-suite.mjs smoke",
    "test:e2e:smoke": "node scripts/run-playwright-suite.mjs smoke",
    "test:e2e:authenticated": "node scripts/run-playwright-suite.mjs authenticated",
    "test:e2e:cleanup": "tsx scripts/cleanup-preview-e2e.ts",
    "test:e2e:safety": "vitest run src/test-support/preview-e2e-safety.test.ts",
    "test:safety": "vitest run src/app/preview-environment-contract.test.mjs src/app/api/preview-identity/route.test.ts src/lib/deploy/verify-preview-environment.test.mjs src/test-support/staging-fixture-safety.test.ts src/test-support/preview-e2e-safety.test.ts src/lib/services/quiz-rpc-compatibility.test.ts",
    "test:watch": "vitest",
    "map:feature": "node scripts/check-feature-map.mjs --feature",
    "map:owner": "node scripts/check-feature-map.mjs --owner",
    "map:flow": "node scripts/check-feature-map.mjs --flow",
    "map:changed": "node scripts/check-feature-map.mjs --changed --base auto",
    "verify:feature-map": "node scripts/check-feature-map.mjs --verify",
    "verify:server-architecture": "vitest run src/app/application-layer-boundaries.test.ts src/app/server-architecture-ratchet.test.ts src/features/assignments/architecture-boundary.test.ts src/design-system/architecture-boundary.test.ts",
    "verify:react-request-cache": "node --conditions react-server scripts/verify-react-request-cache.mjs",
    "verify:architecture:static": "node scripts/check-feature-map.mjs --verify --changed --base auto && node scripts/verify-ui-architecture.mjs",
    "verify:architecture": "npm run verify:architecture:static && npm run verify:server-architecture",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run verify:architecture:static && npm run verify:react-request-cache && npm run build",
    "db:help": "supabase --help",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "secrets:generate": "tsx scripts/generate-secrets.ts",
    "import:vocab": "tsx scripts/import-vocabulary.ts",
    "build:vocab-link": "tsx scripts/build-vocab-link-package.ts",
    "verify:vocab-link": "tsx scripts/verify-vocab-link-package.ts",
    "import:word-index": "tsx scripts/import-word-index.ts",
    "import:vocab-link": "tsx scripts/import-vocab-link-package.ts",
    "import:exam-use": "tsx scripts/import-exam-use-package.ts",
    "import:simseok-sem2-preview": "tsx scripts/import-simseok-sem2-preview.ts",
    "import:simseok-sem2-question-preview": "tsx scripts/import-simseok-sem2-question-preview.ts",
    "import:canonical-question-preview": "tsx scripts/import-canonical-question-preview.ts",
    "import:voca-pronunciation": "tsx scripts/import-voca-pronunciation-package.ts",
    "import:voca-pronunciation-v2": "tsx scripts/import-vocab-pronunciation-release-v2.ts",
    "import:exam-webster-pronunciation-repair": "tsx scripts/import-exam-webster-pronunciation-repair.ts",
    "publish:synthetic-audio": "tsx scripts/publish-synthetic-audio-package.ts",
    "publish:synthetic-word-audio": "tsx scripts/publish-synthetic-word-audio-package.ts",
    "publish:voca-pronunciation-audio-v2": "tsx scripts/publish-vocab-pronunciation-audio-v2.ts",
    "import:approved-pronunciation": "tsx scripts/import-approved-korean-pronunciation-package.ts",
    "import:rule-derived-pronunciation": "tsx scripts/import-rule-derived-korean-pronunciation-package.ts",
    "fixture:ui:ensure": "tsx scripts/ui-test-fixture.ts ensure",
    "fixture:ui:cleanup": "tsx scripts/ui-test-fixture.ts cleanup"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "next": "16.2.12",
    "pretendard": "1.3.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@electric-sql/pglite": "0.5.4",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "supabase": "2.109.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  }
}
