{
  "name": "english-academy-student-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/verify-preview-environment.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:component": "vitest run src/test-support/component-testing.smoke.test.tsx",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "verify:architecture": "node scripts/verify-ui-architecture.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run verify:architecture && npm run build",
    "db:help": "supabase --help",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "secrets:generate": "tsx scripts/generate-secrets.ts",
    "import:vocab": "tsx scripts/import-vocabulary.ts",
    "build:vocab-link": "tsx scripts/build-vocab-link-package.ts",
    "verify:vocab-link": "tsx scripts/verify-vocab-link-package.ts",
    "import:word-index": "tsx scripts/import-word-index.ts",
    "import:vocab-link": "tsx scripts/import-vocab-link-package.ts",
    "import:exam-use": "tsx scripts/import-exam-use-package.ts",
    "fixture:ui:ensure": "tsx scripts/ui-test-fixture.ts ensure",
    "fixture:ui:cleanup": "tsx scripts/ui-test-fixture.ts cleanup"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "next": "16.2.12",
    "pretendard": "1.3.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@electric-sql/pglite": "0.5.4",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "supabase": "2.109.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  }
}
