# Public Supabase connection values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Kakao Developers JavaScript key. Register the production web domain.
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=

# Server-only Supabase key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# 32-byte random values encoded as base64.
STUDENT_CODE_PEPPER=
STUDENT_SESSION_PEPPER=
STUDENT_CODE_ENCRYPTION_KEY=
LOGIN_IP_PEPPER=

# Canonical origin. Required in production for same-origin mutation checks.
APP_ORIGIN=http://localhost:3000

# Preview-only guard. Vercel Preview builds fail unless the URL above matches this ref.
PREVIEW_EXPECTED_SUPABASE_PROJECT_REF=

# Preview E2E. Register these only in protected Preview CI environments.
E2E_ALLOW_PREVIEW_MUTATION=0
E2E_EXPECTED_GIT_REF=
E2E_EXPECTED_PREVIEW_ORIGIN=
E2E_EXPECTED_SUPABASE_PROJECT_REF=
E2E_TARGET_DEPLOYMENT_SHA=
E2E_CHECK_RUNNER_SHA=
PREVIEW_E2E_ADMIN_EMAIL=
PREVIEW_E2E_ADMIN_PASSWORD=
VERCEL_AUTOMATION_BYPASS_SECRET=

# Manual student reading-context sync. Keep Preview and Production folders separate.
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_STUDENT_ROOT_FOLDER_ID=
PREVIEW_EXPECTED_GOOGLE_DRIVE_FOLDER_ID=
